#!/bin/sh
# Runs the CI "quality" stages before a push leaves this machine.
#
# The point is not ceremony: CI takes minutes and the VPS only deploys green
# commits, so a typo pushed at 6pm is a broken main until someone notices.
# This catches it in the terminal where it was written.
#
# Skip deliberately when you mean to:  git push --no-verify
exec node "$(git rev-parse --show-toplevel)/tools/pipeline/cli.mjs" gate
