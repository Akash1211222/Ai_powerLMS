# FutureCorp LMS — production env for Hostinger VPS
# Coexists with landing (futurecorpacademy.in) and legacy API on :4000.
# Copy to /opt/fca-lms/.env and fill secrets. NEVER commit a filled file.

NODE_ENV=production

# Ports — DO NOT use 4000 (taken by /root/futurecorp/backend PM2)
API_PORT=4001
WEB_PORT=3000
API_BASE_URL=https://lms-api.futurecorpacademy.in
WEB_BASE_URL=https://lms.futurecorpacademy.in
CORS_ORIGINS=https://lms.futurecorpacademy.in
NEXT_PUBLIC_API_BASE_URL=https://lms-api.futurecorpacademy.in/api/v1

# Postgres + Redis (installed by deploy/setup-lms-vps.sh)
# MUST be single-quoted: bare & is backgrounded by bash `source .env`
DATABASE_URL='postgresql://fca_lms:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/fca_lms?schema=public&connection_limit=5&pool_timeout=10'
REDIS_URL='redis://127.0.0.1:6379/1'

# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS____________
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS___________
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

SWAGGER_ENABLED=false
RATE_LIMIT_ENABLED=true
# Run the app processes as an unprivileged user. pm2 stays root (it has to, to
# drop privileges), but the API, web and worker do not need it. The user must
# exist before this is set, or the processes will not boot.
APP_USER=fca
# Bind behind nginx only, so a firewall rule is not the only thing between the
# internet and an unencrypted, unrate-limited port. Leave unset (0.0.0.0) in a
# container, where binding to loopback makes the service unreachable.
API_HOST=127.0.0.1
WEB_HOST=127.0.0.1

# Never turn this on here: student code would run beside the database, the
# landing site's leads and the Gemini key.
CODE_RUN_ENABLED=false
# Run student code off-box instead. Judge0-compatible; swap for a self-hosted
# or paid instance if the free one is rate-limited or goes whitelist-only.
CODE_RUNNER_URL=https://ce.judge0.com
# CODE_RUNNER_TOKEN=          # only for instances that require a key
CODE_RUNNER_TIMEOUT_MS=20000
LOG_LEVEL=info
BODY_LIMIT=2mb

# Worker caps for 4 GB VPS
WORKER_SYSTEM_CONCURRENCY=1
WORKER_AI_CONCURRENCY=1
WORKER_INTELLIGENCE_CONCURRENCY=1
NODE_OPTIONS=--max-old-space-size=512

# AI — heuristic until keys are set
AI_PROVIDER=heuristic

# Optional SMTP
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
# Quote for bash `source .env` — angle brackets must not be bare.
MAIL_FROM='FutureCorp Academy <no-reply@futurecorpacademy.in>'
